  "events": [
    {
      "id": "测字先生",
      "text": "路边测字先生托起罗盘:『客官,抽一字,卜一卦。』",
      "options": [
        {
          "label": "求字(得「炎」)",
          "gainChar": "炎"
        },
        {
          "label": "求墨(随机部件 ×2)",
          "randomComponents": 2
        },
        {
          "label": "拱手离开"
        }
      ]
    },
    {
      "id": "墨池",
      "text": "一泓漆黑墨池泛着微光。传说浸墨可锻字,却伤元气。",
      "options": [
        {
          "label": "浸染字库(HP −60,得「沝」)",
          "hpDelta": -60,
          "gainChar": "沝"
        },
        {
          "label": "取墨而归(随机部件 ×2)",
          "randomComponents": 2
        },
        {
          "label": "绕道而行"
        }
      ]
    },
    {
      "id": "废稿堆",
      "text": "你撞见自己历次失败留下的废稿。废稿也是稿。",
      "options": [
        {
          "label": "翻找部件(随机部件 ×3)",
          "randomComponents": 3
        },
        {
          "label": "静心重读(HP +80)",
          "hpDelta": 80
        },
        {
          "label": "转身离去"
        }
      ]
    },
    {
      "id": "书院",
      "text": "山间书院灯火未熄,先生愿留你半日。",
      "options": [
        {
          "label": "休整(HP +150)",
          "hpDelta": 150
        },
        {
          "label": "进修(得「林」)",
          "gainChar": "林"
        },
        {
          "label": "帮抄书换钱(墨锭 +20)",
          "ink": 20
        }
      ]
    },
    {
      "id": "字摊",
      "text": "路旁小摊,摊主捻须:『以物易物,童叟无欺。』",
      "options": [
        {
          "label": "一部件换 3 叠字(任选)",
          "componentCost": 1,
          "gainCharChoices": [
            "鑫",
            "森",
            "淼",
            "焱",
            "垚"
          ]
        },
        {
          "label": "白拿 2 叠字(任选)",
          "gainCharChoices": [
            "鍂",
            "林",
            "沝",
            "炎",
            "圭"
          ]
        },
        {
          "label": "只看不换"
        }
      ]
    },
    {
      "id": "篝火",
      "text": "篝火正旺,暖意驱散了错字的阴气。",
      "options": [
        {
          "label": "休整(HP +200)",
          "hpDelta": 200
        },
        {
          "label": "烤字取暖(随机部件 ×1)",
          "randomComponents": 1
        },
        {
          "label": "起身赶路"
        }
      ]
    },
    {
      "id": "赌书",
      "text": "书生摇扇:『赌一局飞花令?押注方可入席。』",
      "options": [
        {
          "label": "押注对赌(付 30,五成赢 100)",
          "inkCost": 30,
          "ink": 100,
          "inkChancePercent": 50
        },
        {
          "label": "观战学艺(HP +50)",
          "hpDelta": 50
        },
        {
          "label": "拱手不赌"
        }
      ]
    },
    {
      "id": "残碑",
      "text": "半截古碑上一个残字隐约生光,拓印恐伤元气。",
      "options": [
        {
          "label": "拓印残字(HP −80,得「鍂」)",
          "hpDelta": -80,
          "gainChar": "鍂"
        },
        {
          "label": "描摹碑文(随机部件 ×2)",
          "randomComponents": 2
        },
        {
          "label": "肃然离开"
        }
      ]
    },
    {
      "id": "宝库",
      "text": "尘封的藏宝库虚掩着门,金光自缝隙间渗出。",
      "options": [
        {
          "label": "取明面财(墨锭 +40)",
          "ink": 40
        },
        {
          "label": "搜刮暗格(HP −200,墨锭 +80)",
          "hpDelta": -200,
          "ink": 80
        },
        {
          "label": "见好就收"
        }
      ]
    },
    {
      "id": "养气",
      "text": "松下老道盘坐不动:『字有筋骨,人有气脉。静坐一刻,气自厚三分。』",
      "options": [
        {
          "label": "静坐养气(血量上限 +30%)",
          "maxHpPercent": 30
        },
        {
          "label": "讨教笔法(随机部件 ×1)",
          "randomComponents": 1
        },
        {
          "label": "不扰清修"
        }
      ]
    },
    {
      "id": "淬骨",
      "text": "铁匠抡锤不歇:『字要淬,骨也要淬。火里走一遭,成不成看你的命。』",
      "options": [
        {
          "label": "入炉淬骨(八成 上限 +30%,两成 反噬 −30%)",
          "maxHpPercent": 30,
          "maxHpChancePercent": 80
        },
        {
          "label": "只观火候(HP +100)",
          "hpDelta": 100
        },
        {
          "label": "退开三步"
        }
      ]
    },
    {
      "id": "换气",
      "text": "药庐老妪伸出枯手:『一味药引,换你一口真气。』",
      "options": [
        {
          "label": "以物易气(舍 1 部件,上限 +30%)",
          "maxHpPercent": 30,
          "componentCost": 1
        },
        {
          "label": "讨碗凉茶(HP +50)",
          "hpDelta": 50
        },
        {
          "label": "谢过离开"
        }
      ]
    }
