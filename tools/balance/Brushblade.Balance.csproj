<Project Sdk="Microsoft.NET.Sdk">

  <!-- 难度仿真工装(F1 调平):链接 Core/Data 源码,无头跑满章节量化难度曲线。
       用法:tools/balance$ dotnet run -c Release(dotnet 用 Unity 自带 SDK,见 CLAUDE.md)。 -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- 服务器 GC:搜索每节点大量分配(快照 / 局面键),工作站 GC 下 8 核只吃满 2–3 核;实测单画像墙钟 13.6s → 7.1s,读数逐位不变 -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Bot/**/*.cs" />
    <Compile Include="../../Brushblade/Assets/_Project/Core/**/*.cs" />
    <Compile Include="../../Brushblade/Assets/_Project/Data/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
