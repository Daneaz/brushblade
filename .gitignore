# macOS
.DS_Store

# IDE
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Pipeline 大产物(原始数据与中间输出不入 git,见 docs/architecture.md §2)
# 例外:ids.txt 入 git —— test_shipped_chars_json_is_regenerable_from_spec 要靠它
# 重跑管线比对出货字表,不入库这条测试在新克隆的仓库/CI 上只能 skip(2026-08-10)。
# 数据源 cjkvi-ids(GPL 系,基于 CHISE IDS DB),仓库转公开前需在 NOTICE 署源。
tools/pipeline/data/raw/*
!tools/pipeline/data/raw/ids.txt
tools/pipeline/out/

# 字体原始文件(google/fonts, OFL):2026-08-25 起**入 git**。
# 原先不入,理由是体积大、随时能从 google/fonts 重下 —— 但那天一次误操作把本地这两份
# 删掉了,而「随时能重下」在需要它的那一刻不成立(新增中文时必须重跑 subset_fonts.py,
# 拿不到原材料新字就是豆腐块)。43 MB 换掉这个单点故障,值。
# ⚠ 这两行**不带尾斜杠**是有意的:带斜杠只匹配目录,匹配不到软链 ——
# 正是它让那个自引用软链被 git add -A 悄悄收进来,进而覆盖掉真目录。

# dotnet 测试工装构建产物
tools/coretests/bin/
tools/coretests/obj/
tools/balance/bin/
tools/balance/obj/
tools/prescompile/bin/
tools/prescompile/obj/
tools/trace/bin/
tools/trace/obj/

# 黄金轨迹产物(spec §10.2 明写不入 git:它是一次性的验收基线,
# 校验和写进任务报告即可 —— 入库会随每次数值改动产生几 MB 的无意义 diff)
tools/trace/out/

# Unity(项目创建后按需补全 Library/Temp/Logs/obj 等)
Brushblade/Library/
Brushblade/Temp/
Brushblade/Logs/
Brushblade/obj/
Brushblade/UserSettings/
Brushblade/Builds/
